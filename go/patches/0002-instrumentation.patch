+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package queueset
+
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+)
+
+// traceSink receives one JSON line per model action. It is nil, and so
+// every trace call below is a no-op, unless a test installs it.
+// Tracing is for the formal model of this package; see model-contract.md.
+var traceSink func(line []byte)
+
+type traceQueue struct {
+	ID         int   `json:"id"`
+	Index      int   `json:"index"`
+	SeatsInUse int   `json:"seatsInUse"`
+	Waiting    []int `json:"waiting"`
+	Executing  []int `json:"executing"`
+}
+
+type traceLinger struct {
+	Req   int `json:"req"`
+	Queue int `json:"queue"`
+	Width int `json:"width"`
+}
+
+type tracePost struct {
+	Desired       int           `json:"desired"`
+	TotSeatsInUse int           `json:"totSeatsInUse"`
+	Panicked      bool          `json:"panicked"`
+	Queues        []traceQueue  `json:"queues"`
+	Lingering     []traceLinger `json:"lingering"`
+}
+
+type traceRecord struct {
+	Seq     int       `json:"seq"`
+	Ev      string    `json:"ev"`
+	Req     *int      `json:"req,omitempty"`
+	Queue   *int      `json:"queue,omitempty"`
+	Width   *int      `json:"width,omitempty"`
+	Lingers *bool     `json:"lingers,omitempty"`
+	Desired int       `json:"desired"`
+	Msg     string    `json:"msg,omitempty"`
+	Post    tracePost `json:"post"`
+}
+
+// traceLocked writes one record. The caller holds qs.lock and has
+// completed the action's effects. r is nil for init and reconfigure.
+func (qs *queueSet) traceLocked(ev string, r *request, panicMsg any) {
+	if traceSink == nil {
+		return
+	}
+	rec := traceRecord{Seq: qs.traceSeq, Ev: ev, Desired: qs.qCfg.DesiredNumQueues}
+	qs.traceSeq++
+	if r != nil {
+		id, qid, w, l := r.id, r.queue.id, r.MaxSeats(), r.workEstimate.AdditionalLatency > 0
+		rec.Req, rec.Queue, rec.Width, rec.Lingers = &id, &qid, &w, &l
+	}
+	rec.Post = tracePost{Desired: qs.qCfg.DesiredNumQueues, TotSeatsInUse: qs.totSeatsInUse, Panicked: ev == "panic",
+		Queues: []traceQueue{}, Lingering: []traceLinger{}}
+	if panicMsg != nil {
+		rec.Msg = fmt.Sprint(panicMsg)
+	}
+	for _, q := range qs.queues {
+		tq := traceQueue{ID: q.id, Index: q.index, SeatsInUse: q.seatsInUse, Waiting: []int{}, Executing: []int{}}
+		q.requestsWaiting.Walk(func(w *request) bool { tq.Waiting = append(tq.Waiting, w.id); return true })
+		for e := range q.requestsExecuting {
+			tq.Executing = append(tq.Executing, e.id)
+		}
+		sort.Ints(tq.Executing)
+		rec.Post.Queues = append(rec.Post.Queues, tq)
+	}
+	for l := range qs.traceLingering {
+		rec.Post.Lingering = append(rec.Post.Lingering, traceLinger{l.id, l.queue.id, l.MaxSeats()})
+	}
+	sort.Slice(rec.Post.Lingering, func(i, j int) bool { return rec.Post.Lingering[i].Req < rec.Post.Lingering[j].Req })
+	line, err := json.Marshal(rec)
+	if err != nil {
+		panic(err)
+	}
+	traceSink(line)
+}
+
+// traceSetLingering records that r has finished but not yet released its seats.
+func (qs *queueSet) traceSetLingering(r *request, lingering bool) {
+	if traceSink == nil {
+		return
+	}
+	if qs.traceLingering == nil {
+		qs.traceLingering = map[*request]struct{}{}
+	}
+	if lingering {
+		qs.traceLingering[r] = struct{}{}
+	} else {
+		delete(qs.traceLingering, r)
+	}
+}
+
+// traceRecoverLocked is deferred, with qs.lock held, around code that may
+// panic in removeQueueAndUpdateIndexes. It records the panic and re-panics.
+func (qs *queueSet) traceRecoverLocked(r *request) {
+	if traceSink == nil {
+		return
+	}
+	if p := recover(); p != nil {
+		qs.traceSetLingering(r, false)
+		qs.traceLocked("panic", r, p)
+		panic(p)
+	}
+}
